# ===================== NextCode — variáveis de ambiente =====================

# --- Segurança (Fases 2–4) ---
# FASE 2 (P0): chave mestra AES-256-GCM para criptografar API keys no SQLite.
# Gere uma: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sem ela, as chaves continuam em texto plano (compatibilidade) com warning no log.
NEXTCODE_MASTER_KEY=

# FASE 8 (rotação de chaves): lista de chaves aceitas, separadas por vírgula.
# A PRIMEIRA é a ativa (usada para novas escritas); as demais só decifram dados
# antigos durante a janela de rotação. Deixe vazio para usar apenas a chave única acima.
# Procedimento completo: node scripts/rotate-master-key.mjs
# NEXTCODE_MASTER_KEYS=<nova>,<antiga>

# FASE 4: token exigido (header X-Nextcode-Token) nas rotas mutativas /api/*.
# Se vazio, um token aleatório é gerado em memória e entregue via POST /api/auth/session.
NEXTCODE_AUTH_TOKEN=

# Só com proxy reverso confiável na frente (que ACRESCENTA o IP do cliente em X-Forwarded-For):
# o rate limit passa a ser por IP. Sem proxy, deixe vazio — o header é forjável pelo cliente.
NEXTCODE_TRUST_PROXY=

# Limite de requisições por IP/minuto nas rotas protegidas (default 30)
# NEXTCODE_RATE_LIMIT=30

# Dev: apaga todo .next antes do next dev só quando NEXTCODE_DEV_FORCE_CLEAN=1
# (ou quando existe BUILD_ID de um next build). Default preserva cache para subir mais rápido.
# NEXTCODE_DEV_FORCE_CLEAN=1
# NEXTCODE_DEV_NO_TURBO=1
# NEXTCODE_WORKER_DEV_DELAY_MS=2000
# NEXTCODE_PRISMA_QUERY_LOG=1

# FASE 3 (anti-SSRF): hosts extras permitidos além de localhost/host.docker.internal
# SSRF_ALLOWED_HOSTS=meu-gateway.interno

# --- Orquestração (teste real) ---
# Desliga pausa por teto de custo da DAG (config/politicas-orquestracao.yaml continua em 0,50).
# Remova ou comente para voltar ao teto normal. Preferível em .env.local (só dev).
# NEXTCODE_TETO_CUSTO=desligado
# Conferência na aprovação da Spec: ativo | sombra | desligado (produção: YAML sombra).
# NEXTCODE_CONFERENCIA_ENTRADA=sombra

# --- Sandbox do terminal (Fase 5) ---
# "on" exige docker CLI + socket disponível; qualquer outro valor usa modo local.
NEXTCODE_SANDBOX_JAIL=off
# NEXTCODE_SANDBOX_MEM=512m
# NEXTCODE_SANDBOX_CPUS=1

# --- Provedores diretos (fallback BYOK) ---
# GEMINI_API_KEY=
