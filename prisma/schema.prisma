datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Setting {
  id             String   @id @default("default")
  geminiKey      String?
  claudeKey      String?
  openaiKey      String?
  deepseekKey    String?
  groqKey        String?
  nvidiaKey      String?
  omniRouteKey   String?
  // 20128 = porta oficial do OmniRoute no docker-compose.yml (8080 era um default obsoleto
  // que fazia o router apontar para porta fechada -> "Cotas e Serviços Indisponíveis")
  omniRouteUrl   String?  @default("http://localhost:20128/v1")
  customEndpoint String?  @default("http://localhost:20128/v1")
  activeProvider String   @default("auto")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CustomProvider {
  id        String   @id // slug ex: "ollama-local"
  name      String
  baseUrl   String
  apiKey    String?
  models    String   // JSON string: [{ "id": "deepseek-r1:14b", "name": "DeepSeek R1 14B" }]
  headers   String?  // JSON string: { "Authorization": "Bearer ..." }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model McpServer {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("stdio") // "stdio" | "sse"
  command   String?  // para stdio
  args      String?  // JSON array string ex: '["-y", "@mcp/server-filesystem"]'
  url       String?  // para sse
  env       String?  // JSON object string
  status    String   @default("offline") // "online" | "offline" | "error"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  path        String?   // Caminho absoluto da pasta na máquina local
  isPinned    Boolean   @default(false)
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]
}


model Session {
  id            String     @id @default(uuid())
  projectId     String?
  title         String     @default("Nova Sessão")
  specApproved  Boolean    @default(false)
  intakeScenario String?
  turnCount     Int        @default(0)
  canonicalSpec String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         TaskNode[]
  messages      Message[]
}

model TaskNode {
  id             String   @id @default(uuid())
  sessionId      String
  title          String
  role           String   @default("worker")
  cluster        String   @default("backend")
  filesScope     String   @default("[]") // JSON Array de arquivos escopados
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  quarantinePath String?
  status         String   @default("pending") // 'pending' | 'running' | 'completed' | 'failed' | 'blocked' | 'quarantine'
  dependencies   String   @default("[]") // JSON Array de IDs de tarefas dependentes
  mcpScope       String?  // Ferramentas MCP escopadas para este nó
  payload        String?  // JSON string contendo entrada / contexto do nó
  result         String?  // JSON string contendo saída / resultado da execução
  failureHistory String   @default("[]") // JSON Array de FailureAttemptRecord (Trava T6 - D-RANHO)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  role      String   // 'user' | 'assistant' | 'system' | 'tool'
  content   String
  tokens    Int      @default(0)
  tier      String   @default("fast") // 'fast' | 'heavy'
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TelemetryLog {
  id         String   @id @default(uuid())
  sessionId  String?
  action     String
  details    String?  // JSON string contendo metadados
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
}

model CandidateSkillProposal {
  id             String   @id @default(uuid())
  name           String
  description    String
  triggerPattern String
  sampleContent  String
  status         String   @default("pending") // 'pending' | 'approved' | 'rejected' | 'disabled'
  source         String   @default("learned") // 'learned' (minerada de telemetria) | 'github' (importada via URL de terceiros)
  sourceUrl      String? // URL original informada pelo operador (source=github)
  resolvedUrl    String? // URL raw efetivamente usada no fetch (branch resolvida)
  commitSha      String? // SHA do commit pineado no momento da revisão, quando resolvível (best-effort)
  contentHash    String? // sha256 do conteúdo revisado — permite detectar drift se o arquivo de origem mudar depois
  detectedType   String? // 'google' | 'claude' | 'cursor' | 'codex' | 'generic'
  targetPath     String? // diretório base (projeto) onde a skill será/foi gravada
  installedPath  String? // caminho final no disco após approve (fonte da verdade para o gate de governança)
  riskFlags      String? // JSON array de sinais heurísticos não-bloqueantes encontrados no conteúdo (prompt injection, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

